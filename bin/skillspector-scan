#!/usr/bin/env bash
# skillspector-scan — thin wrapper around NVIDIA/SkillSpector
# Uses ANTHROPIC_API_KEY from ~/.hermes/.env when available; falls back to --no-llm
#
# Usage:
#   skillspector-scan <skill-path-or-url>           # LLM-enhanced if key present
#   skillspector-scan <skill-path> --no-llm         # static only
#   skillspector-scan <skill-path> --format json    # machine-readable output

set -euo pipefail

QUIVER="${QUIVER_PATH:-$HOME/projects/skill-quiver}"
VENV="$QUIVER/resources/skillspector/.venv"

if [ ! -f "$VENV/bin/activate" ]; then
  echo "Error: SkillSpector not installed. Run:" >&2
  echo "  cd $QUIVER/resources/skillspector && python3 -m venv .venv && source .venv/bin/activate && pip install -e ." >&2
  exit 1
fi

# Load secrets if key not already set
if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -f "$HOME/.hermes/.env" ]; then
  # shellcheck disable=SC1091
  set -a; source "$HOME/.hermes/.env"; set +a
fi

source "$VENV/bin/activate"

if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  SKILLSPECTOR_PROVIDER=anthropic skillspector scan "$@"
else
  echo "[skillspector] No ANTHROPIC_API_KEY — running static analysis only" >&2
  skillspector scan --no-llm "$@"
fi
